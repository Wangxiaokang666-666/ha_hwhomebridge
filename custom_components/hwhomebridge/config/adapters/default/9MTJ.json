{
    "pid": "9MTJ",
    "services": {
        "switch": {
            "domain": "light",
            "action": "turn_on_off",
            "value_attr": "state"
        },
        "brightness": {
            "domain": "light",
            "action": "set_brightness",
            "value_attr": "brightness",
            "brightness_range": 100
        },
        "status": {
            "domain": "sensor",
            "action": "read_only",
            "value_attr": "state",
            "value_mapping": {
                "type": "text_to_enum",
                "mapping": {
                    "无人": 0,
                    "有人": 1
                }
            }
        },
        "cct": {
            "domain": "light",
            "action": "set_color_temp",
            "value_attr": "",
            "colorTemperature_range": 6500,
            "colorTemperature_min": 2000
        }
    }
}
