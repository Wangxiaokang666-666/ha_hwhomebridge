{
  "pid": "fixture-light",
  "services": {
    "switch": {
      "role": "main",
      "domain": "light",
      "action": "turn_on_off",
      "value_attr": "state",
      "options": {}
    },
    "brightness": {
      "role": "main",
      "domain": "light",
      "action": "set_brightness",
      "value_attr": "brightness",
      "options": {
        "ha_maximum": 255,
        "tolerance": 1
      },
      "brightness_range": 100
    },
    "cct": {
      "role": "main",
      "domain": "light",
      "action": "set_color_temp",
      "value_attr": "color_temp_kelvin",
      "options": {},
      "colorTemperature_min": 2700,
      "colorTemperature_range": 6500
    },
    "effect": {
      "role": "main",
      "domain": "light",
      "action": "set_effect",
      "value_attr": "effect",
      "options": {
        "effect": "reading"
      }
    },
    "ambient": {
      "role": "ambient",
      "domain": "light",
      "action": "turn_on_off",
      "value_attr": "state",
      "options": {}
    }
  }
}
